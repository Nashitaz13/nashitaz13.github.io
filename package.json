{
  "name": "bui-ngoc-thai-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:hero": "node scripts/check-foundation.mjs --hero",
    "check:projects": "node scripts/check-projects-content.mjs && node scripts/check-foundation.mjs --projects",
    "check:profile": "node scripts/check-projects-content.mjs && node scripts/check-foundation.mjs --profile",
    "check:ux": "node scripts/check-projects-content.mjs && node scripts/check-foundation.mjs --ux"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
